# UniMart Production Environment Configuration
# Copy this to .env and fill in your actual keys

# Frontend Keys (Vite requires VITE_ prefix)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Backend Keys
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=unimart_db

JWT_SECRET=your_super_secret_jwt_key_here
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NODE_ENV=production
